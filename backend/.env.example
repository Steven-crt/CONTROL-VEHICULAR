# ─── Base de datos MySQL / Aiven ───────────────────────────────────────────────
DB_HOST=mysql-XXXXXXXX-XXXXXXXX.j.aivencloud.com
DB_PORT=19923
DB_USER=avnadmin
DB_PASSWORD=tu_password_de_aiven
DB_NAME=defaultdb
# SSL requerido para Aiven (dejar en true en producción)
DB_SSL=true

# ─── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001

# ─── Autenticación JWT ─────────────────────────────────────────────────────────
JWT_SECRET=cambia-este-secreto-muy-seguro-en-produccion
JWT_EXPIRES_IN=8h

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Separar múltiples orígenes con comas
CORS_ORIGIN=http://localhost:5173,https://control-vehicular.vercel.app
