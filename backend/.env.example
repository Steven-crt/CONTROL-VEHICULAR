# --- Conexion a base de datos ---
# Opcion A: cadena de conexion completa (prioritaria si la defines).
DATABASE_URL=

# Opcion B: variables individuales (si no usas DATABASE_URL).
# El puerto y el usuario dependen de tu proveedor; no copies los de produccion.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Obligatorio en MySQL gestionado. En local puedes poner false.
DB_SSL=true



# --- Seguridad ---

JWT_SECRET=
JWT_EXPIRES_IN=8h


DATA_ENCRYPTION_KEY=

# --- Limite de peticiones ---

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180

# --- Rendimiento bajo carga ---

REPORTES_CACHE_MS=10000

# --- CORS ---

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173


PUBLIC_URL=http://localhost:3001

# --- Servidor ---
PORT=3001
NODE_ENV=development



ADMIN_INITIAL_PASSWORD=