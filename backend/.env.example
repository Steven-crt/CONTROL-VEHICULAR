# ============================================================
# CONTROL VEHICULAR - BACKEND (.env)
# Copia este archivo a ".env" y completa los valores.
# En Render, estos valores van en: Dashboard > tu servicio > Environment
# ============================================================

# --- Opción A (RECOMENDADA para Aiven): pega la URI completa ---
# En Aiven: pestaña "Overview" > "Connection information" (o Aiven Console > tu servicio MySQL).
# Se ve parecida a:
#   mysql://avnadmin:CLAVE@mysql-xxxx.aivencloud.com:26355/defaultdb?ssl-mode=REQUIRED
# Esta URI incluye host, puerto, usuario, clave y base de datos (defaultdb).
DATABASE_URL=

# --- Opción B: variables individuales (si no usas DATABASE_URL) ---
DB_HOST=
DB_PORT=26355            # El puerto NO es 3306 en Aiven; mira la URI que te da Aiven
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb        # Aiven usa "defaultdb" como base por defecto

# Aiven exige SSL. En local puedes poner false.
DB_SSL=true

# --- Seguridad ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h

# --- CORS ---
# Orígenes permitidos separados por coma. Los subdominios *.vercel.app se permiten solos.
CORS_ORIGIN=http://localhost:5173,https://control-vehicular.vercel.app

# --- Servidor ---
PORT=3001
