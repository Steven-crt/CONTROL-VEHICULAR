# ============================================================
# CONTROL VEHICULAR - BACKEND (.env)
# Copia este archivo a ".env" y completa los valores.
# En Render, estos valores van en: Dashboard > tu servicio > Environment
# ============================================================

# --- Opción A (RECOMENDADA para Aiven): pega la URI completa ---
# En Aiven: pestaña "Overview" > "Connection information" (o Aiven Console > tu servicio MySQL).
# Se ve parecida a:
#   mysql://avnadmin:CLAVE@mysql-xxxx.aivencloud.com:26355/defaultdb?ssl-mode=REQUIRED
# Esta URI incluye host, puerto, usuario, clave y base de datos (defaultdb).
DATABASE_URL=

# --- Opción B: variables individuales (si no usas DATABASE_URL) ---
DB_HOST=
DB_PORT=26355            # El puerto NO es 3306 en Aiven; mira la URI que te da Aiven
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb        # Aiven usa "defaultdb" como base por defecto

# Aiven exige SSL. En local puedes poner false.
DB_SSL=true
# (OPCIONAL pero recomendado) Validación estricta del certificado de Aiven.
# Descarga el CA de Aiven (Service settings > CA Certificate) y pon la ruta:
# DB_CA_CERT=./ca.pem
# O pega el contenido del certificado directamente:
# DB_CA_PEM=

# --- Seguridad ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En producción (Render) es OBLIGATORIO: el backend no arranca sin él.
# IMPORTANTE: no uses caracteres como #, $ o espacios (dotenv los interpreta como comentario).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Clave de cifrado de datos sensibles (email, etc.) — AES-256-GCM.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (64 caracteres hex). Si no se define, los datos se guardan en claro
# (modo compatibilidad; el cifrado se activa automáticamente al definirla).
DATA_ENCRYPTION_KEY=

# --- Rate limiting ---
# Ventana en ms y máximo de peticiones por IP sobre /api (login usa su propio límite).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180

# --- Rendimiento bajo carga ---
# Máximo de conexiones MySQL simultáneas (default 15 — seguro para Aiven free).
# Súbelo si tu plan de Aiven tiene más conexiones disponibles (p.ej. 25-50).
DB_POOL_SIZE=15
# Cola máxima de peticiones esperando conexión. Al llenarse se responde 503
# ("Servicio saturado") en vez de acumular memoria indefinidamente.
DB_QUEUE_LIMIT=50
# Umbral (ms) para loguear queries lentas en consola (default 500).
DB_SLOW_QUERY_MS=500
# Caché del dashboard en servidor (ms). El dashboard es global (misma flota para
# todos): 1 solo cálculo real cada TTL aunque haya cientos de usuarios.
REPORTES_CACHE_MS=10000

# --- CORS ---
# Orígenes permitidos separados por coma (dominios exactos).
CORS_ORIGIN=http://localhost:5173,https://control-vehicular-iota.vercel.app,https://control-vehicular.vercel.app

# --- Servidor ---
PORT=3001
NODE_ENV=production

# --- Admin ---
# Contraseña inicial del usuario admin (solo primer arranque).
# Cámbialo después con: node scripts/reset_admin.js
ADMIN_INITIAL_PASSWORD=
