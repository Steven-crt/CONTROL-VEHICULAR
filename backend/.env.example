# --- Conexion a base de datos ---
# Opcion A: cadena de conexion completa (prioritaria si la defines).
DATABASE_URL=

# Opcion B: variables individuales (si no usas DATABASE_URL).
# El puerto y el usuario dependen de tu proveedor; no copies los de produccion.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Obligatorio en MySQL gestionado. En local puedes poner false.
DB_SSL=true

# Opcional: validacion estricta del certificado del servidor.
# Descarga el CA de tu proveedor y indica la ruta, o pega el contenido:
# DB_CA_CERT=./ca.pem
# DB_CA_PEM=

# --- Seguridad ---
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En produccion es OBLIGATORIO: el backend no arranca sin ella.
# IMPORTANTE: no uses caracteres como #, $ o espacios (dotenv los interpreta como comentario).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Clave de cifrado de datos sensibles (email, etc.) con AES-256-GCM.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (64 caracteres hex). Si no se define, los datos se guardan en claro
# (modo compatibilidad; el cifrado se activa automaticamente al definirla).
DATA_ENCRYPTION_KEY=

# --- Limite de peticiones ---
# Ventana en ms y maximo de peticiones por IP sobre /api (login usa su propio limite).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180

# --- Rendimiento bajo carga ---
# Conexiones MySQL simultaneas. Sube solo si tu plan lo permite.
DB_POOL_SIZE=15
# Peticiones maximas en cola esperando conexion. Al llenarse se responde 503
# en vez de acumular memoria indefinidamente.
DB_QUEUE_LIMIT=50
# Umbral en ms para loguear queries lentas.
DB_SLOW_QUERY_MS=500
# Cache del dashboard en servidor (ms). El dashboard es global: un solo
# calculo real por TTL aunque haya muchos usuarios concurrentes.
REPORTES_CACHE_MS=10000

# --- CORS ---
# Origenes permitidos separados por coma (coincidencia EXACTA, sin comodines).
# En produccion solo dominios reales: si se deja vacio, la API rechaza todo
# acceso cross-origin (fail-closed) en lugar de abrirlo.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Base publica del backend: se usa para construir las URLs de /uploads.
# Definela en produccion; si no, se deduce del primer valor de CORS_ORIGIN.
PUBLIC_URL=http://localhost:3001

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Admin ---
# Contrasena inicial del usuario admin (solo primer arranque).
# Cambiala despues con: node scripts/reset_admin.js
ADMIN_INITIAL_PASSWORD=